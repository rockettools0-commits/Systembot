TOKEN=DEIN_DISCORD_BOT_TOKEN

# Einzelner Owner (legacy — wird weiterhin unterstützt):
OWNER_ID=123456789012345678

# Mehrere Owner (kommagetrennt — überschreibt/ergänzt OWNER_ID):
# OWNER_IDS=123456789012345678,987654321098765432,111222333444555666

# ── Minecraft Verifizierung ────────────────────────────────────────────────────
# Port auf dem der Discord-Bot auf Codes von der Bridge lauscht
MC_VERIFY_PORT=8766
# Muss identisch mit mc_bridge/.env BRIDGE_SECRET sein!
MC_BRIDGE_SECRET=aendere-mich-zu-einem-langen-zufaelligen-string
# Ingame-Name des Mineflayer-Bot-Accounts (was User in /msg schreiben)
MC_BOT_NAME=HugoSMPBot
# Discord-Rollen-ID die nach Verifizierung vergeben wird (0 = deaktiviert)
MC_VERIFIED_ROLE_ID=0
